     | "e" ((/[0-9A-Za-kmo-z]/ /[A-Za-z0-9]/* | "l" ((/[0-9A-Za-hj-rt-z]/ /[A-Za-z0-9]/* | "i" ((/[0-9A-Za-eg-z]/ /[A-Za-z0-9]/* | "f" /[A-Za-z0-9]/+))? | "s" ((/[0-9A-Za-df-z]/ /[A-Za-z0-9]/* | "e" /[A-Za-z0-9]/+))?))? | "n" ((/[0-9A-Za-tv-z]/ /[A-Za-z0-9]/* | "u" ((/[0-9A-Za-ln-z]/ /[A-Za-z0-9]/* | "m" /[A-Za-z0-9]/+))?))?))?
