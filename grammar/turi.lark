digits: /[0-9]/ digits?
number: ("0" ("x" | "X") /[0-9A-Fa-f]/+ | "0" ("b" | "B") /[01]/+ | digits ("." digits)? (("e" | "E") (("+" | "-"))? digits)?) h
BOOL: ("true" | "false") (/[ \t]/*)
interp_string: "\"" ((/[^"\\\x00-\x1F{}]/ | "\\" /["\\nrt{}]/ | "{{" | "}}" | "{" h expr "}"))* "\"" h
STRING: "\"" ((/[^"\\\x00-\x1F{}]/ | "\\" /["\\nrt{}]/ | "{{" | "}}"))* "\"" (/[ \t]/*)
