fn main() {
    let seed = readSeed()
    let n = 262144
    var a = repeat(seed, n)
    for i in 0..n {
        a[i] = (i + seed) % 1009
    }
    for p in 0..32 {
        for i in 0..n {
            a[i] = (a[i] + p + 1) % 1009
        }
    }
    var total = 0
    for i in 0..n {
        total += a[i]
    }
    print(total)
}
