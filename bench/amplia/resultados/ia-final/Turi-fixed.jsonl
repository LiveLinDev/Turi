{"kind": "attempt", "task": "digitProduct", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 8, "text": "fn digitProduct(n: int) -> int {\n    if n == 0 {\n        return 0\n    }\n    var product = 1\n    while n > 0 {\n        var digit = n % 10\n        if digit == 0 {\n            return 0\n        }\n        product *= digit\n        n /= 10\n    }\n    return product\n}", "logical": 369, "fresh": 51, "cached": 318, "out": 82, "prompt_ms": 69.076, "decode_ms": 2310.668, "raw": false, "compiled": true, "public": true, "hidden": true, "fixed": true, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "sumOddBelow", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 8, "text": "fn sumOddBelow(n: int) -> int {\n    var sum = 0\n    for i in 1..n {\n        if i % 2 == 1 {\n            sum += i\n        }\n    }\n    return sum\n}", "logical": 367, "fresh": 49, "cached": 318, "out": 52, "prompt_ms": 68.454, "decode_ms": 1505.755, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "coprimePair", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn coprimePair(n: int, k: int) -> bool {\n    var a = n\n    var b = k\n    while b != 0 {\n        let temp = b\n        b = a % b\n        a = temp\n    }\n    return a == 1\n}", "logical": 377, "fresh": 59, "cached": 318, "out": 64, "prompt_ms": 70.975, "decode_ms": 1846.975, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "sameSign", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 5, "text": "fn sameSign(a: int, b: int) -> bool {\n    if (a == 0 && b == 0) {\n        return true\n    }\n    if (a > 0 && b > 0) {\n        return true\n    }\n    if (a < 0 && b < 0) {\n        return true\n    }\n    return false\n}", "logical": 371, "fresh": 50, "cached": 321, "out": 80, "prompt_ms": 64.242, "decode_ms": 2353.309, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
