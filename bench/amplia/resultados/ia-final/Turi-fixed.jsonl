{"kind": "attempt", "task": "nextOrbit", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 8, "text": "fn nextOrbit(n: int) -> int {\n    if n % 2 == 0 {\n        return n / 2\n    }\n    return 3 * n + 1\n}", "logical": 373, "fresh": 55, "cached": 318, "out": 42, "prompt_ms": 68.178, "decode_ms": 1236.437, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "sumMultiples", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn sumMultiples(n: int, k: int) -> int {\n    var sum = 0\n    var multiple = k\n    while multiple <= n {\n        sum += multiple\n        multiple += k\n    }\n    return sum\n}", "logical": 381, "fresh": 63, "cached": 318, "out": 52, "prompt_ms": 66.01, "decode_ms": 1495.6, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "ceilHalf", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 8, "text": "fn ceilHalf(n: int) -> int {\n    var result = n / 2\n    if n % 2 != 0 {\n        result += 1\n    }\n    return result\n}", "logical": 367, "fresh": 49, "cached": 318, "out": 43, "prompt_ms": 67.859, "decode_ms": 1202.089, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "decimalZeroes", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 5, "text": "fn decimalZeroes(n: int) -> int {\n    var count = 0\n    while n > 0 {\n        if n % 10 == 0 {\n            count += 1\n        }\n        n /= 10\n    }\n    return count\n}", "logical": 375, "fresh": 57, "cached": 318, "out": 59, "prompt_ms": 66.51, "decode_ms": 1683.328, "raw": false, "compiled": true, "public": true, "hidden": false, "fixed": true, "cause": "HIDDEN", "feedback": ""}
{"kind": "attempt", "task": "wrapMinute", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn wrapMinute(n: int) -> int {\n    var result = n % 60\n    if result < 0 {\n        result += 60\n    }\n    return result\n}", "logical": 372, "fresh": 54, "cached": 318, "out": 42, "prompt_ms": 67.192, "decode_ms": 1184.49, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "stepToward", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": false, "hidden_tests": 4, "text": "fn stepToward(a: int, b: int) -> int {\n    if a == b {\n        return a\n    }\n    a += 1\n}", "logical": 373, "fresh": 55, "cached": 318, "out": 35, "prompt_ms": 63.952, "decode_ms": 1005.118, "raw": false, "compiled": false, "public": false, "hidden": false, "fixed": false, "cause": "E_IMMUTABLE", "feedback": "El nombre es de solo lectura: a"}
{"kind": "attempt", "task": "stepToward", "lang": "Turi", "mode": "fixed", "attempt": 2, "terminal": true, "hidden_tests": 4, "text": "fn stepToward(a: int, b: int) -> int {\n    if a == b {\n        return a\n    }\n    var result = a\n    result += 1\n    return result\n}", "logical": 432, "fresh": 25, "cached": 407, "out": 45, "prompt_ms": 55.071, "decode_ms": 1296.723, "raw": true, "compiled": true, "public": true, "hidden": false, "fixed": false, "cause": "HIDDEN", "feedback": ""}
{"kind": "attempt", "task": "powerOfThree", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn powerOfThree(n: int) -> bool {\n    if n == 0 {\n        return false\n    }\n    while n % 3 == 0 {\n        n /= 3\n    }\n    return n == 1\n}", "logical": 369, "fresh": 51, "cached": 318, "out": 51, "prompt_ms": 66.122, "decode_ms": 1521.931, "raw": false, "compiled": true, "public": true, "hidden": true, "fixed": true, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "endRun", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 5, "text": "fn endRun(n: int, k: int) -> int {\n    var count = 0\n    while n % k == 0 {\n        n /= k\n        count += 1\n    }\n    return count\n}", "logical": 383, "fresh": 65, "cached": 318, "out": 49, "prompt_ms": 74.822, "decode_ms": 1424.633, "raw": false, "compiled": true, "public": true, "hidden": true, "fixed": true, "cause": "OK", "feedback": ""}
