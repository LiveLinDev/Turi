{"kind": "attempt", "task": "roundMultiple", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn roundMultiple(n: int, k: int) -> int {\n    var result = n\n    while result % k != 0 {\n        result += 1\n    }\n    return result\n}", "logical": 381, "fresh": 66, "cached": 315, "out": 43, "prompt_ms": 69.862, "decode_ms": 1276.043, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
