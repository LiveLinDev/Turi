{"kind": "attempt", "task": "nextOrbit", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 8, "text": "fn nextOrbit(n: int) -> int {\n    if n % 2 == 0 {\n        return n / 2\n    }\n    return 3 * n + 1\n}", "logical": 373, "fresh": 373, "cached": 0, "out": 42, "prompt_ms": 163.781, "decode_ms": 1196.267, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "sumMultiples", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn sumMultiples(n: int, k: int) -> int {\n    var sum = 0\n    var multiple = k\n    while multiple <= n {\n        sum += multiple\n        multiple += k\n    }\n    return sum\n}", "logical": 381, "fresh": 381, "cached": 0, "out": 52, "prompt_ms": 161.231, "decode_ms": 1494.484, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "ceilHalf", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 8, "text": "fn ceilHalf(n: int) -> int {\n    var result = n / 2\n    if n % 2 != 0 {\n        result += 1\n    }\n    return result\n}", "logical": 367, "fresh": 367, "cached": 0, "out": 43, "prompt_ms": 162.642, "decode_ms": 1268.718, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
{"kind": "attempt", "task": "decimalZeroes", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 5, "text": "fn decimalZeroes(n: int) -> int {\n    var count = 0\n    while n > 0 {\n        if n % 10 == 0 {\n            count += 1\n        }\n        n /= 10\n    }\n    return count\n}", "logical": 375, "fresh": 375, "cached": 0, "out": 59, "prompt_ms": 165.481, "decode_ms": 1703.874, "raw": false, "compiled": true, "public": true, "hidden": false, "fixed": true, "cause": "HIDDEN", "feedback": ""}
{"kind": "attempt", "task": "wrapMinute", "lang": "Turi", "mode": "fixed", "attempt": 1, "terminal": true, "hidden_tests": 6, "text": "fn wrapMinute(n: int) -> int {\n    var result = n % 60\n    if result < 0 {\n        result += 60\n    }\n    return result\n}", "logical": 372, "fresh": 372, "cached": 0, "out": 42, "prompt_ms": 165.839, "decode_ms": 1191.373, "raw": true, "compiled": true, "public": true, "hidden": true, "fixed": false, "cause": "OK", "feedback": ""}
