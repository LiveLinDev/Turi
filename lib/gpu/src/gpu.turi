    if ptrIsNull(ctx.ptr) || ptrIsNull(buf.ptr) || len(salida) != buf.longitud {
        return Err("Longitud incompatible en bajarF32Pinned")
    }
    trusted {
        var ms = 0.0
        if tz_gpu_buf_download_pinned(ctx.ptr, buf.ptr, mutSlicePtr(mut salida), i64(buf.longitud), mutPtrOf(mut ms)) == i32(0) {
            return Err("Error leyendo buffer pinned desde GPU")
