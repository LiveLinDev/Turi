        return Ok(TiempoGpu { h2dMs: h2d, kernelMs: kern, d2hMs: d2h, totalMs: h2d + kern + d2h })
    }
}

// Calibrated RX 9070 XT vs Ryzen 7 7700X crossover dispatch (with safe CPU fallback)
fn saxpyAutoF32(alpha: f32, x: [f32], y: mut [f32]) -> Result<TiempoGpu, str> {
    let n = len(x)
    if len(y) != n {
        return Err("Longitudes distintas en saxpyAutoF32")
    }
    if n >= 33554432 && disponible() {
        match iniciar() {
            Ok(ctx) => {
                let res = saxpyF32(ctx, alpha, x, mut y)
                cerrar(ctx)
                if res.isOk() {
                    return res
                }
            }
            Err(_) => {}
        }
    }
    for i in 0..n {
        y[i] = alpha * x[i] + y[i]
    }
    return Ok(TiempoGpu { h2dMs: 0.0, kernelMs: 0.0, d2hMs: 0.0, totalMs: 0.0 })
}

fn matmulAutoF32(a: [f32], b: [f32], c: mut [f32], m: int, k: int, n: int) -> Result<TiempoGpu, str> {
    if m <= 0 || k <= 0 || n <= 0 {
        return Err("Dimensiones no positivas en matmulAutoF32")
    }
    if len(a) != m * k || len(b) != k * n || len(c) != m * n {
        return Err("Dimensiones incompatibles con los arreglos en matmulAutoF32")
    }
    // GPU cold crossover calibrated at ~645^3 ops (N=512 stays on multi-thread CPU 0.64ms vs GPU cold 0.83ms; N>=768 uses GPU)
    if m * k * n >= 268435456 && disponible() {
        match iniciar() {
            Ok(ctx) => {
                let res = matmulF32(ctx, a, b, mut c, m, k, n)
                cerrar(ctx)
                if res.isOk() {
                    return res
                }
            }
            Err(_) => {}
        }
    }
    for ix in 0..(m * n) { c[ix] = f32(0.0) }
    for i in 0..m {
        for p in 0..k {
            let aip = a[i * k + p]
            for j in 0..n {
                c[i * n + j] = c[i * n + j] + aip * b[p * n + j]
            }
        }
    }
    return Ok(TiempoGpu { h2dMs: 0.0, kernelMs: 0.0, d2hMs: 0.0, totalMs: 0.0 })
}

// English API aliases
fn isAvailable() -> bool { return disponible() }
fn deviceName() -> str { return nombreDispositivo() }
fn init() -> Result<ContextoGpu, str> { return iniciar() }
fn close(ctx: ContextoGpu) { cerrar(ctx) }
fn allocBufferF32(ctx: ContextoGpu, count: int) -> Result<BufferF32, str> { return crearBufferF32(ctx, count) }
fn freeBuffer(buf: BufferF32) { liberarBuffer(buf) }
fn uploadF32(ctx: ContextoGpu, buf: BufferF32, data: [f32]) -> Result<float, str> { return subirF32(ctx, buf, data) }
fn downloadF32(ctx: ContextoGpu, buf: BufferF32, out: mut [f32]) -> Result<float, str> { return bajarF32(ctx, buf, mut out) }
fn saxpyResidentF32(ctx: ContextoGpu, alpha: f32, bx: BufferF32, by: BufferF32) -> Result<float, str> {
    return saxpyResidenteF32(ctx, alpha, bx, by)
}
fn matmulResidentF32(ctx: ContextoGpu, ba: BufferF32, bb: BufferF32, bc: BufferF32, m: int, k: int, n: int) -> Result<float, str> {
    return matmulResidenteF32(ctx, ba, bb, bc, m, k, n)
}
fn backendName() -> str { return nombreBackend() }
fn availableBackends() -> str { return backendsDisponibles() }
fn uploadF32Pinned(ctx: ContextoGpu, buf: BufferF32, data: [f32]) -> Result<float, str> { return subirF32Pinned(ctx, buf, data) }
fn downloadF32Pinned(ctx: ContextoGpu, buf: BufferF32, out: mut [f32]) -> Result<float, str> { return bajarF32Pinned(ctx, buf, mut out) }
fn saxpyReluResidentF32(ctx: ContextoGpu, alpha: f32, bx: BufferF32, by: BufferF32) -> Result<float, str> {
    return saxpyReluResidenteF32(ctx, alpha, bx, by)
}
fn matmulReluResidentF32(ctx: ContextoGpu, ba: BufferF32, bb: BufferF32, bc: BufferF32, m: int, k: int, n: int) -> Result<float, str> {
    return matmulReluResidenteF32(ctx, ba, bb, bc, m, k, n)
}
fn reluResidentF32(ctx: ContextoGpu, bx: BufferF32, by: BufferF32) -> Result<float, str> { return reluResidenteF32(ctx, bx, by) }
fn vecAddResidentF32(ctx: ContextoGpu, ba: BufferF32, bb: BufferF32, bo: BufferF32) -> Result<float, str> {
    return vecAddResidenteF32(ctx, ba, bb, bo)
}
