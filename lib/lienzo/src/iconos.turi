// Catalogo de iconos vectoriales SVG path (viewBox 24x24 en centesimas 0..2400).

struct Icono {
    nombre: str
    trazos: [[int]]
    relleno: bool
    cerrado: [bool]
}

struct LecturaFloat {
    ok: bool
    valor: float
    siguiente: int
}

struct EstadoRuta {
    cx: float
    cy: float
    sx: float
    sy: float
    qpx: float
    qpy: float
    ultimoEsBezierQ: bool
    trazoActual: [int]
    trazos: [[int]]
    cerrado: [bool]
}

fn esDigito(b: int) -> bool {
    return b >= 48 && b <= 57
}

fn esLetraCmd(b: int) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn esSeparador(b: int) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 44
}

fn saltarSep(d: str, pos: int) -> int {
    var i = pos
    let n = len(d)
    while i < n && esSeparador(int(d[i])) {
        i += 1
    }
    return i
}

fn leerNumero(d: str, pos: int) -> LecturaFloat {
    var i = saltarSep(d, pos)
    let n = len(d)
    if i >= n {
        return LecturaFloat { ok: false, valor: 0.0, siguiente: i }
    }
    var signo = 1.0
    if int(d[i]) == 45 {
        signo = -1.0
        i += 1
    } else if int(d[i]) == 43 {
        i += 1
    }
    if i >= n || (!esDigito(int(d[i])) && int(d[i]) != 46) {
        return LecturaFloat { ok: false, valor: 0.0, siguiente: i }
    }
    var entero = 0.0
    var vioDig = false
    while i < n && esDigito(int(d[i])) {
        entero = entero * 10.0 + float(int(d[i]) - 48)
        vioDig = true
        i += 1
    }
    var frac = 0.0
    var div = 1.0
    if i < n && int(d[i]) == 46 {
        i += 1
        while i < n && esDigito(int(d[i])) {
            frac = frac * 10.0 + float(int(d[i]) - 48)
            div *= 10.0
            vioDig = true
            i += 1
        }
    }
    if !vioDig {
        return LecturaFloat { ok: false, valor: 0.0, siguiente: i }
    }
    return LecturaFloat { ok: true, valor: signo * (entero + frac / div), siguiente: i }
}

fn aCentesimas(v: float) -> int {
    return int((v * 100.0).round())
}

fn agregarPunto(st: mut EstadoRuta, x: float, y: float) {
    push(mut st.trazoActual, aCentesimas(x))
    push(mut st.trazoActual, aCentesimas(y))
}

fn cerrarTrazoAbierto(st: mut EstadoRuta, cerrar: bool) {
    if len(st.trazoActual) >= 4 {
        push(mut st.trazos, st.trazoActual)
        push(mut st.cerrado, cerrar)
    }
    st.trazoActual = []
}

fn muestrearCubica(st: mut EstadoRuta, x1: float, y1: float, x2: float, y2: float, x3: float, y3: float) {
    let x0 = st.cx
    let y0 = st.cy
    let pasos = 12
    for k in 1..(pasos + 1) {
        let t = float(k) / float(pasos)
        let u = 1.0 - t
        let b0 = u * u * u
        let b1 = 3.0 * u * u * t
        let b2 = 3.0 * u * t * t
        let b3 = t * t * t
        let x = b0 * x0 + b1 * x1 + b2 * x2 + b3 * x3
        let y = b0 * y0 + b1 * y1 + b2 * y2 + b3 * y3
        agregarPunto(mut st, x, y)
    }
    st.cx = x3
    st.cy = y3
}

fn muestrearCuadratica(st: mut EstadoRuta, qx: float, qy: float, x2: float, y2: float) {
    let x0 = st.cx
    let y0 = st.cy
    let pasos = 12
    for k in 1..(pasos + 1) {
        let t = float(k) / float(pasos)
        let u = 1.0 - t
        let b0 = u * u
        let b1 = 2.0 * u * t
        let b2 = t * t
        let x = b0 * x0 + b1 * qx + b2 * x2
        let y = b0 * y0 + b1 * qy + b2 * y2
        agregarPunto(mut st, x, y)
    }
    st.cx = x2
    st.cy = y2
    st.qpx = qx
    st.qpy = qy
    st.ultimoEsBezierQ = true
}

fn parsearRutaEn(nombre: str, d: str, relleno: bool) -> Icono {
    var st = EstadoRuta {
        cx: 0.0,
        cy: 0.0,
        sx: 0.0,
        sy: 0.0,
        qpx: 0.0,
        qpy: 0.0,
        ultimoEsBezierQ: false,
        trazoActual: [],
        trazos: [],
        cerrado: [],
    }
    var i = 0
    let n = len(d)
    var cmd = 0
    while i < n {
        i = saltarSep(d, i)
        if i >= n { break }
        let ch = int(d[i])
        if esLetraCmd(ch) {
            cmd = ch
            i += 1
            if cmd == 90 || cmd == 122 { // Z / z
                cerrarTrazoAbierto(mut st, true)
                st.cx = st.sx
                st.cy = st.sy
                st.ultimoEsBezierQ = false
                cmd = 0
                continue
            }
        }
        if cmd == 0 {
            i += 1
            continue
        }
        let relativo = cmd >= 97 && cmd <= 122
        let up = if relativo { cmd - 32 } else { cmd }

        if up == 77 { // M / m
            let lx = leerNumero(d, i)
            if !lx.ok { break }
            let ly = leerNumero(d, lx.siguiente)
            if !ly.ok { break }
            i = ly.siguiente
            cerrarTrazoAbierto(mut st, false)
            let nx = if relativo { st.cx + lx.valor } else { lx.valor }
            let ny = if relativo { st.cy + ly.valor } else { ly.valor }
            st.cx = nx
            st.cy = ny
            st.sx = nx
            st.sy = ny
            agregarPunto(mut st, nx, ny)
            st.ultimoEsBezierQ = false
            cmd = if relativo { 108 } else { 76 } // siguientes pares son L/l
        } else if up == 76 { // L / l
            let lx = leerNumero(d, i)
            if !lx.ok { break }
            let ly = leerNumero(d, lx.siguiente)
            if !ly.ok { break }
            i = ly.siguiente
            let nx = if relativo { st.cx + lx.valor } else { lx.valor }
            let ny = if relativo { st.cy + ly.valor } else { ly.valor }
            agregarPunto(mut st, nx, ny)
            st.cx = nx
            st.cy = ny
            st.ultimoEsBezierQ = false
        } else if up == 72 { // H / h
            let lx = leerNumero(d, i)
            if !lx.ok { break }
            i = lx.siguiente
            let nx = if relativo { st.cx + lx.valor } else { lx.valor }
            agregarPunto(mut st, nx, st.cy)
            st.cx = nx
            st.ultimoEsBezierQ = false
        } else if up == 86 { // V / v
            let ly = leerNumero(d, i)
            if !ly.ok { break }
            i = ly.siguiente
            let ny = if relativo { st.cy + ly.valor } else { ly.valor }
            agregarPunto(mut st, st.cx, ny)
            st.cy = ny
            st.ultimoEsBezierQ = false
        } else if up == 81 { // Q / q
            let lqx = leerNumero(d, i)
            if !lqx.ok { break }
            let lqy = leerNumero(d, lqx.siguiente)
            if !lqy.ok { break }
            let lx = leerNumero(d, lqy.siguiente)
            if !lx.ok { break }
            let ly = leerNumero(d, lx.siguiente)
            if !ly.ok { break }
            i = ly.siguiente
            let qx = if relativo { st.cx + lqx.valor } else { lqx.valor }
            let qy = if relativo { st.cy + lqy.valor } else { lqy.valor }
            let nx = if relativo { st.cx + lx.valor } else { lx.valor }
            let ny = if relativo { st.cy + ly.valor } else { ly.valor }
            muestrearCuadratica(mut st, qx, qy, nx, ny)
        } else if up == 67 { // C / c
            let l1x = leerNumero(d, i)
            if !l1x.ok { break }
            let l1y = leerNumero(d, l1x.siguiente)
            if !l1y.ok { break }
            let l2x = leerNumero(d, l1y.siguiente)
            if !l2x.ok { break }
            let l2y = leerNumero(d, l2x.siguiente)
            if !l2y.ok { break }
            let l3x = leerNumero(d, l2y.siguiente)
            if !l3x.ok { break }
            let l3y = leerNumero(d, l3x.siguiente)
            if !l3y.ok { break }
            i = l3y.siguiente
            let x1 = if relativo { st.cx + l1x.valor } else { l1x.valor }
            let y1 = if relativo { st.cy + l1y.valor } else { l1y.valor }
            let x2 = if relativo { st.cx + l2x.valor } else { l2x.valor }
            let y2 = if relativo { st.cy + l2y.valor } else { l2y.valor }
            let x3 = if relativo { st.cx + l3x.valor } else { l3x.valor }
            let y3 = if relativo { st.cy + l3y.valor } else { l3y.valor }
            muestrearCubica(mut st, x1, y1, x2, y2, x3, y3)
            st.ultimoEsBezierQ = false
        } else if up == 79 { // O cx cy r (extension circulo)
            let lcx = leerNumero(d, i)
            if !lcx.ok { break }
            let lcy = leerNumero(d, lcx.siguiente)
            if !lcy.ok { break }
            let lr = leerNumero(d, lcy.siguiente)
            if !lr.ok { break }
            i = lr.siguiente
            cerrarTrazoAbierto(mut st, false)
            let ccx = if relativo { st.cx + lcx.valor } else { lcx.valor }
            let ccy = if relativo { st.cy + lcy.valor } else { lcy.valor }
            let rr = lr.valor
            let segs = 24
            let dosPi = 6.28318530718
            for k in 0..segs {
                let ang = (float(k) * dosPi) / float(segs)
                let px = ccx + rr * cos(ang)
                let py = ccy + rr * sin(ang)
                agregarPunto(mut st, px, py)
            }
            cerrarTrazoAbierto(mut st, true)
            st.cx = ccx
            st.cy = ccy
            st.sx = ccx
            st.sy = ccy
            st.ultimoEsBezierQ = false
        } else {
            break
        }
    }
    cerrarTrazoAbierto(mut st, false)
    return Icono {
        nombre: nombre,
        trazos: st.trazos,
        relleno: relleno,
        cerrado: st.cerrado,
    }
}

fn nombresIconos() -> [str] {
    return [
        "archivos",
        "carpeta",
        "buscar",
        "esquema",
        "libro",
        "birrete",
        "mas",
        "check",
        "play",
        "paquete",
        "matraz",
        "engranaje",
        "sol",
        "luna",
        "menu",
        "mas3",
        "cerrar",
        "izq",
        "der",
        "bombilla",
        "ojo",
        "recargar",
        "rayo",
        "casa",
        "terminal",
        "lupaDoc",
    ]
}

fn definicionIcono(nombre: str) -> Icono {
    if nombre == "archivos" {
        return parsearRutaEn(nombre, "M14 3 L6 3 Q4 3 4 5 L4 19 Q4 21 6 21 L18 21 Q20 21 20 19 L20 9 Z M14 3 L14 9 L20 9", false)
    } else if nombre == "carpeta" {
        return parsearRutaEn(nombre, "M3 7 Q3 5 5 5 L9 5 L11 7 L19 7 Q21 7 21 9 L21 17 Q21 19 19 19 L5 19 Q3 19 3 17 Z", false)
    } else if nombre == "buscar" || nombre == "lupaDoc" {
        return parsearRutaEn(nombre, "O 11 11 7 M16.5 16.5 L21 21", false)
    } else if nombre == "esquema" {
        return parsearRutaEn(nombre, "M9 6 H20 M9 12 H20 M9 18 H20 M4 6 H4.5 M4 12 H4.5 M4 18 H4.5", false)
    } else if nombre == "libro" {
        return parsearRutaEn(nombre, "M4 19 V5 Q4 3 6 3 H20 V17 H6 Q4 17 4 19 Q4 21 6 21 H20", false)
    } else if nombre == "birrete" {
        return parsearRutaEn(nombre, "M2 10 L12 5 L22 10 L12 15 Z M6 12 V17 Q12 20 18 17 V12 M22 10 V16", false)
    } else if nombre == "mas" {
        return parsearRutaEn(nombre, "M12 5 V19 M5 12 H19", false)
    } else if nombre == "check" {
        return parsearRutaEn(nombre, "M20 6 L9 17 L4 12", false)
    } else if nombre == "play" {
        return parsearRutaEn(nombre, "M7 4 L19 12 L7 20 Z", true)
    } else if nombre == "paquete" {
        return parsearRutaEn(nombre, "M3 7 L12 3 L21 7 L12 11 Z M3 7 V17 L12 21 L21 17 V7 M12 11 V21", false)
    } else if nombre == "matraz" {
        return parsearRutaEn(nombre, "M9 3 H15 M10 3 V9 L4 19 Q3 21 5 21 H19 Q21 21 20 19 L14 9 V3 M7 15 H17", false)
    } else if nombre == "engranaje" {
        return parsearRutaEn(nombre, "O 12 12 3 O 12 12 7 M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M5 5 L7 7 M17 17 L19 19 M5 19 L7 17 M17 7 L19 5", false)
    } else if nombre == "sol" {
        return parsearRutaEn(nombre, "O 12 12 4 M12 2 V4 M12 20 V22 M2 12 H4 M20 12 H22 M5 5 L6.5 6.5 M17.5 17.5 L19 19 M5 19 L6.5 17.5 M17.5 6.5 L19 5", false)
    } else if nombre == "luna" {
        return parsearRutaEn(nombre, "M21 12.8 Q19 18 13 18 Q6 18 6 11 Q6 5 11.2 3 Q8 10 14 13 Q17 15 21 12.8 Z", false)
    } else if nombre == "menu" {
        return parsearRutaEn(nombre, "M4 6 H20 M4 12 H20 M4 18 H20", false)
    } else if nombre == "mas3" {
        return parsearRutaEn(nombre, "O 5 12 1.6 O 12 12 1.6 O 19 12 1.6", true)
    } else if nombre == "cerrar" {
        return parsearRutaEn(nombre, "M6 6 L18 18 M18 6 L6 18", false)
    } else if nombre == "izq" {
        return parsearRutaEn(nombre, "M15 18 L9 12 L15 6", false)
    } else if nombre == "der" {
        return parsearRutaEn(nombre, "M9 18 L15 12 L9 6", false)
    } else if nombre == "bombilla" {
        return parsearRutaEn(nombre, "M9 18 H15 M10 21 H14 M12 3 Q6 3 6 9 Q6 12 9 14 V16 H15 V14 Q18 12 18 9 Q18 3 12 3 Z", false)
    } else if nombre == "ojo" {
        return parsearRutaEn(nombre, "M2 12 Q7 5 12 5 Q17 5 22 12 Q17 19 12 19 Q7 19 2 12 Z O 12 12 3", false)
    } else if nombre == "recargar" {
        return parsearRutaEn(nombre, "M4 4 V9 H9 M20 20 V15 H15 M5 9 Q7 4 12 4 Q17 4 19 8 M19 15 Q17 20 12 20 Q7 20 5 16", false)
    } else if nombre == "rayo" {
        return parsearRutaEn(nombre, "M13 2 L4 14 H12 L11 22 L20 10 H12 Z", false)
    } else if nombre == "casa" {
        return parsearRutaEn(nombre, "M3 11 L12 3 L21 11 M5 9 V21 H19 V9", false)
    } else if nombre == "terminal" {
        return parsearRutaEn(nombre, "M4 17 L10 11 L4 5 M12 19 H20", false)
    }
    return parsearRutaEn(nombre, "O 12 12 6", false)
}

fn catalogo() -> Map<str, Icono> {
    var cat: Map<str, Icono> = mapWithCap(48)
    for nom in nombresIconos() {
        cat.set(nom, definicionIcono(nom))
    }
    return cat
}

fn buscarEnCatalogo(cat: Map<str, Icono>, nombre: str) -> Icono {
    return cat.get(nombre).unwrapOr(definicionIcono(nombre))
}

fn icono(nombre: str) -> Icono {
    return definicionIcono(nombre)
}
