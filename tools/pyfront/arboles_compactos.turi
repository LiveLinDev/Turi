// La posición del nodo i del árbol j es i*treeCount + j.
raw fn tzTreeFill(nodes: MutPtr<u64>, planeDepth: int, treeCount: int) {
    let leaves = 1 << planeDepth
    if leaves < 64 {
        ptrWrite(nodes, wrappingSub(u64(1) << u64(leaves), u64(1) << u64(treeCount)))
        return
    }
    let words = leaves / 64
    let sentinels = treeCount / 64
    for block in 0..words {
        let branches = if block < sentinels { u64(0) } else { ~u64(0) }
        ptrWrite(ptrAdd(nodes, block), branches)
        ptrWrite(ptrAdd(nodes, words + block), u64(0))
    }
    if sentinels == 0 {
        ptrWrite(nodes, ~u64(0) << u64(treeCount))
    }
}

raw fn tzTreeCount(nodes: Ptr<u64>, end: int) -> int {
    let words = (end + 63) / 64
    var count = 0
    for block in 0..words {
        count = wrappingAdd(count, int(popcnt(ptrRead(ptrAdd(nodes, block)))))
    }
    return 2 * count + 1
}

trusted fn tzTreeRun(maxDepth: int, minDepth: int) {
    let stretchSize = 1 << (maxDepth + 2)
    let permanentSize = 1 << (maxDepth + 1)
    var scratch = repeat(u64(0), (stretchSize + 63) / 64)
    var permanent = repeat(u64(0), (permanentSize + 63) / 64)
    let work = mutSlicePtr(mut scratch)
    let saved = mutSlicePtr(mut permanent)
    raw { tzTreeFill(work, maxDepth + 1, 1) }
    var stretchCount = 0
    trusted { raw { stretchCount = tzTreeCount(ptrConst(work), stretchSize) } }
    pyOutI(stretchCount, false)
    write("\n")
    raw { tzTreeFill(saved, maxDepth, 1) }
    for block in 0..((maxDepth - minDepth) / 2 + 1) {
        let depth = minDepth + 2 * block
        let planeDepth = min(maxDepth, depth + 11)
        let treeCount = 1 << (planeDepth - depth)
        let size = 1 << (planeDepth + 1)
        let words = (size + 63) / 64
        let batches = 1 << (maxDepth - planeDepth + minDepth)
        var total = 0
        for batch in 0..batches {
            // La arena temporal admite dos lotes de esta longitud.
            let tree = ptrAdd(work, (batch & 1) * words)
            var count = 0
            raw {
                tzTreeFill(tree, planeDepth, treeCount)
                count = tzTreeCount(ptrConst(tree), size)
            }
            total = wrappingAdd(total, wrappingAdd(count, treeCount - 1))
        }
        pyOutI(total, false)
        write("\n")
    }
    var permanentCount = 0
    trusted { raw { permanentCount = tzTreeCount(ptrConst(saved), permanentSize) } }
    pyOutI(permanentCount, false)
    write("\n")
}
