struct TzPrimeTotals {
    size: int,
    total: int
}

fn tzComposite(out: TzPrimeTotals, source: TzPrimeTotals, before: TzPrimeTotals, p: int) -> TzPrimeTotals {
    return TzPrimeTotals {
        size: wrappingSub(out.size, wrappingSub(source.size, before.size)),
        total: wrappingSub(out.total, wrappingMul(p, wrappingSub(source.total, before.total)))
    }
}

fn tzPrimeWheel(n: int, prefix: [u64]) -> TzPrimeTotals {
    let cycles = n / 210
    let offset = n % 210
    let tail = tzPrimeUnpack(prefix[offset])
    let two = if n >= 2 { 1 } else { 0 }
    let three = if n >= 3 { 1 } else { 0 }
    let five = if n >= 5 { 1 } else { 0 }
    let seven = if n >= 7 { 1 } else { 0 }
    // Cada período deja 48 residuos. Sus valores suman 5040 en el primero.
    return TzPrimeTotals {
        size: 48 * cycles + tail.size - 1 + two + three + five + seven,
        total: 5040 * cycles * cycles + 210 * cycles * tail.size + tail.total - 1 +
            2 * two + 3 * three + 5 * five + 7 * seven
    }
}

fn tzPrimeRank(n: int, prefix: [u64]) -> int {
    // La raíz es menor que 32768. El error de 19973/2^22 queda por debajo de 1/210.
    let value = u32(n)
    let quotient = (value * u32(19973)) >> u32(22)
    let remainder = value - quotient * u32(210)
    return int(u32(48) * quotient) + int(prefix[int(remainder)] & u64(0xffffffff))
}

fn tzPrimePack(cell: TzPrimeTotals) -> u64 {
    return (u64(cell.total) << u64(32)) | u64(cell.size)
}

fn tzPrimeUnpack(cell: u64) -> TzPrimeTotals {
    return TzPrimeTotals { size: int(cell & u64(0xffffffff)), total: int(cell >> u64(32)) }
}

fn tzPrimeFreeze(active: mut [u64], rank: int) {
    let word = rank / 64
    active[word] = active[word] & ~(u64(1) << u64(rank & 63))
}

fn tzPrimeTotals(n: int) -> (int, int) {
    let root = int(sqrt(float(n)))
    let high = n / (root + 1)
    let zero = TzPrimeTotals { size: 0, total: 0 }
    // La tabla pequeña llega hasta 32767. El recuento y la suma caben en 32 bits.
    var small = repeat(u64(0), root + 1)
    let prefix = [
        TZ_PRIME_WHEEL_PREFIX
    ]
    let residues = [
        TZ_PRIME_WHEEL_RESIDUES
    ]
    // Los divisores grandes alcanzables desde 1 son productos de primos >= 11.
    // Solo se guardan en orden creciente los divisores coprimos con la rueda.
    let members = tzPrimeRank(root, prefix)
    let bigCount = tzPrimeRank(high, prefix)
    let wheelBlocks = (members + 47) / 48
    var inverse = repeat(0.0, wheelBlocks * 48 + 1)
    var positions = repeat(u16(0), wheelBlocks * 48 + 1)
    var big = repeat(zero, bigCount + 1)
    var active = repeat(~u64(0), (bigCount + 64) / 64)
    for value in 1..min(210, root + 1) {
        small[value] = tzPrimePack(tzPrimeWheel(value, prefix))
    }
    // A partir del segundo período los cuatro primos base están incluidos.
    // Solo cambian el múltiplo de 210 y la contribución del prefijo de la rueda.
    let low = simdSplat<Simd<u64, 8>>(u64(0xffffffff))
    for cycle in 1..(root / 210 + 1) {
        let from = cycle * 210
        let width = min(210, root + 1 - from)
        let bias = (u64(5040 * cycle * cycle + 16) << u64(32)) | u64(48 * cycle + 3)
        let shift = u64(from) << u64(32)
        let biases = simdSplat<Simd<u64, 8>>(bias)
        let shifts = simdSplat<Simd<u64, 8>>(shift)
        var at = 0
        while at + 8 <= width {
            let packed = simdFromArray<Simd<u64, 8>>(prefix, at)
            simdToArray(packed + biases + (packed & low) * shifts, mut small, from + at)
            at = at + 8
        }
        for offset in at..width {
            let packed = prefix[offset]
            small[from + offset] = wrappingAdd(wrappingAdd(packed, bias),
                                               wrappingMul(packed & u64(0xffffffff), shift))
        }
    }
    for block in 0..wheelBlocks {
        let shift = simdSplat<Simd<u16, 16>>(u16(block * 210))
        for group in 0..3 {
            let first = group * 16
            let ids = simdFromArray<Simd<u16, 16>>(residues, first) + shift
            simdToArray(ids, mut positions, block * 48 + first + 1)
        }
    }
    let divisors = [
        TZ_PRIME_WHEEL_DIVISORS
    ]
    let one = simdSplat<Simd<float, 8>>(1.0)
    let increment = simdSplat<Simd<u64, 8>>(u64(1))
    // Los recíprocos comparten los índices de positions. El redondeo hacia
    // arriba conserva el cociente entero hasta 2^30.
    for block in 0..wheelBlocks {
        let delta = simdSplat<Simd<float, 8>>(float(block * 210))
        for group in 0..6 {
            let row = group * 8
            let number = simdFromArray<Simd<float, 8>>(divisors, row) + delta
            let bits = bitcast<Simd<u64, 8>>(one / number) + increment
            simdToArray(bitcast<Simd<float, 8>>(bits), mut inverse, block * 48 + row + 1)
        }
    }
    for rank in 1..(bigCount + 1) {
        let value = int(float(n) * inverse[rank])
        big[rank] = tzPrimeWheel(value, prefix)
    }
    for primeRank in 2..(members + 1) {
        let prime = int(positions[primeRank])
        let before = tzPrimeUnpack(small[prime - 1])
        if (small[prime] & u64(0xffffffff)) == u64(before.size) {
            continue
        }
        let square = prime * prime
        let invPrime = inverse[primeRank]
        let scaled = float(int(float(n) * invPrime))
        let last = min(high, int(scaled * invPrime))
        let split = min(last, int(float(high) * invPrime))
        let firstEnd = tzPrimeRank(split, prefix) + 1
        let lastEnd = tzPrimeRank(last, prefix) + 1
        // Si se consulta un divisor compuesto, se lee con el estado anterior a
        // su menor factor primo. Sus actualizaciones posteriores ya sobran.
        if prime <= high {
            tzPrimeFreeze(mut active, primeRank)
            for index in primeRank..firstEnd {
                let multiple = int(positions[index]) * prime
                tzPrimeFreeze(mut active, tzPrimeRank(multiple, prefix))
            }
        }
        let head = if prime <= high { big[primeRank] } else { tzPrimeUnpack(small[int(scaled)]) }
        big[1] = tzComposite(big[1], head, before, prime)
        let begin = primeRank + 1
        if begin < lastEnd {
            for word in (begin / 64)..((lastEnd + 63) / 64) {
                let base = word * 64
                let left = max(0, begin - base)
                let right = min(64, lastEnd - base)
                let lowerMask = ~u64(0) << u64(left)
                let upperMask = ~u64(0) >> u64(64 - right)
                var pending = active[word] & lowerMask & upperMask
                while pending != u64(0) {
                    let rank = base + int(ctz(pending))
                    pending = pending & wrappingSub(pending, u64(1))
                    let i = int(positions[rank])
                    let source = if rank < firstEnd { big[tzPrimeRank(i * prime, prefix)] }
                                 else { tzPrimeUnpack(small[int(scaled * inverse[rank])]) }
                    big[rank] = tzComposite(big[rank], source, before, prime)
                }
            }
        }
        var value = root
        if value >= square {
            var quotient = int(float(value) * invPrime)
            var boundary = quotient * prime
            while value >= square {
                // El cociente es constante dentro del grupo y queda por debajo
                // de cada destino. Se puede recorrer el grupo en orden creciente.
                let first = max(boundary, square)
                let source = tzPrimeUnpack(small[quotient])
                let count = wrappingSub(source.size, before.size)
                let total = wrappingMul(prime, wrappingSub(source.total, before.total))
                // El recuento que se resta está contenido en el destino.
                // Por tanto, la resta del campo bajo no toma un préstamo del alto.
                let delta = (u64(total) << u64(32)) | u64(count)
                let amount = simdSplat<Simd<u64, 8>>(delta)
                var at = first
                while at + 7 <= value {
                    let cells = simdFromArray<Simd<u64, 8>>(small, at)
                    simdToArray(cells - amount, mut small, at)
                    at = at + 8
                }
                for i in at..(value + 1) {
                    small[i] = wrappingSub(small[i], delta)
                }
                value = first - 1
                quotient = quotient - 1
                boundary = boundary - prime
            }
        }
    }
    let result = if high > 0 { big[1] } else { tzPrimeUnpack(small[n]) }
    return (result.size, result.total)
}
