raw fn tzLifeSides(board: Ptr<u32>, at: int, stride: int) -> (Simd<u32, 16>, Simd<u32, 16>, Simd<u32, 16>, (Simd<u32, 16>, Simd<u32, 16>)) {
    let center = simdLoad<Simd<u32, 16>>(ptrAdd(board, at))
    let before = simdLoad<Simd<u32, 16>>(ptrAdd(board, at - stride))
    let after = simdLoad<Simd<u32, 16>>(ptrAdd(board, at + stride))
    let one = simdSplat<Simd<u32, 16>>(u32(1))
    let high = simdSplat<Simd<u32, 16>>(u32(31))
    let left = (center << one) | (before >> high)
    let right = (center >> one) | (after << high)
    let odd = left ^ right
    let carry = left & right
    return (center, odd, carry, (odd ^ center, carry | (odd & center)))
}

fn tzLifeSum(a: Simd<u32, 16>, b: Simd<u32, 16>, c: Simd<u32, 16>) -> (Simd<u32, 16>, Simd<u32, 16>) {
    let parity = a ^ b
    return (parity ^ c, (a & b) | (parity & c))
}

fn tzLifePopulation(live: Simd<u32, 16>) -> Simd<u32, 16> {
    var out = simdSplat<Simd<u32, 16>>(u32(0))
    out = simdSet(out, 0, u32(popcnt(simdGet(live, 0))))
    out = simdSet(out, 1, u32(popcnt(simdGet(live, 1))))
    out = simdSet(out, 2, u32(popcnt(simdGet(live, 2))))
    out = simdSet(out, 3, u32(popcnt(simdGet(live, 3))))
    out = simdSet(out, 4, u32(popcnt(simdGet(live, 4))))
    out = simdSet(out, 5, u32(popcnt(simdGet(live, 5))))
    out = simdSet(out, 6, u32(popcnt(simdGet(live, 6))))
    out = simdSet(out, 7, u32(popcnt(simdGet(live, 7))))
    out = simdSet(out, 8, u32(popcnt(simdGet(live, 8))))
    out = simdSet(out, 9, u32(popcnt(simdGet(live, 9))))
    out = simdSet(out, 10, u32(popcnt(simdGet(live, 10))))
    out = simdSet(out, 11, u32(popcnt(simdGet(live, 11))))
    out = simdSet(out, 12, u32(popcnt(simdGet(live, 12))))
    out = simdSet(out, 13, u32(popcnt(simdGet(live, 13))))
    out = simdSet(out, 14, u32(popcnt(simdGet(live, 14))))
    out = simdSet(out, 15, u32(popcnt(simdGet(live, 15))))
    return out
}

fn tzLifeNonempty(live: Simd<u32, 16>) -> bool {
    return simdReduceMax(live) != u32(0)
}

fn tzLifeUp(previous: Simd<u32, 16>, current: Simd<u32, 16>) -> Simd<u32, 16> {
    var shifted = simdSplat<Simd<u32, 16>>(u32(0))
    shifted = simdSet(shifted, 0, simdGet(previous, 15))
    shifted = simdSet(shifted, 1, simdGet(current, 0))
    shifted = simdSet(shifted, 2, simdGet(current, 1))
    shifted = simdSet(shifted, 3, simdGet(current, 2))
    shifted = simdSet(shifted, 4, simdGet(current, 3))
    shifted = simdSet(shifted, 5, simdGet(current, 4))
    shifted = simdSet(shifted, 6, simdGet(current, 5))
    shifted = simdSet(shifted, 7, simdGet(current, 6))
    shifted = simdSet(shifted, 8, simdGet(current, 7))
    shifted = simdSet(shifted, 9, simdGet(current, 8))
    shifted = simdSet(shifted, 10, simdGet(current, 9))
    shifted = simdSet(shifted, 11, simdGet(current, 10))
    shifted = simdSet(shifted, 12, simdGet(current, 11))
    shifted = simdSet(shifted, 13, simdGet(current, 12))
    shifted = simdSet(shifted, 14, simdGet(current, 13))
    shifted = simdSet(shifted, 15, simdGet(current, 14))
    return shifted
}

fn tzLifeDown(current: Simd<u32, 16>, next: Simd<u32, 16>) -> Simd<u32, 16> {
    var shifted = simdSplat<Simd<u32, 16>>(u32(0))
    shifted = simdSet(shifted, 0, simdGet(current, 1))
    shifted = simdSet(shifted, 1, simdGet(current, 2))
    shifted = simdSet(shifted, 2, simdGet(current, 3))
    shifted = simdSet(shifted, 3, simdGet(current, 4))
    shifted = simdSet(shifted, 4, simdGet(current, 5))
    shifted = simdSet(shifted, 5, simdGet(current, 6))
    shifted = simdSet(shifted, 6, simdGet(current, 7))
    shifted = simdSet(shifted, 7, simdGet(current, 8))
    shifted = simdSet(shifted, 8, simdGet(current, 9))
    shifted = simdSet(shifted, 9, simdGet(current, 10))
    shifted = simdSet(shifted, 10, simdGet(current, 11))
    shifted = simdSet(shifted, 11, simdGet(current, 12))
    shifted = simdSet(shifted, 12, simdGet(current, 13))
    shifted = simdSet(shifted, 13, simdGet(current, 14))
    shifted = simdSet(shifted, 14, simdGet(current, 15))
    shifted = simdSet(shifted, 15, simdGet(next, 0))
    return shifted
}

// Cada tablero tiene (columns + 2) * stride palabras y ambos son disjuntos.
// El intervalo activo deja un vector de filas y una columna de margen a cada lado.
raw fn tzLifeStep(input: Ptr<u32>, output: MutPtr<u32>, stride: int, columns: int, lo: int, hi: int,
                  loBlock: int, hiBlock: int, counting: bool) -> (int, int, int, (int, int)) {
    var first = lo
    var last = hi
    // La población cabe en u32 con el tamaño máximo del tablero.
    var total = simdSplat<Simd<u32, 16>>(u32(0))
    var firstBlock = loBlock
    var lastBlock = hiBlock
    let zero = simdSplat<Simd<u32, 16>>(u32(0))
    let one = simdSplat<Simd<u32, 16>>(u32(1))
    let high = simdSplat<Simd<u32, 16>>(u32(1) << u32(31))
    for block in loBlock..(hiBlock + 1) {
        let offset = block * stride
        var up = tzLifeSides(input, offset + (lo - 1) * 16, stride)
        var middle = tzLifeSides(input, offset + lo * 16, stride)
        var any = zero
        for row in lo..(hi + 1) {
            let at = offset + row * 16
            let south = tzLifeSides(input, at + 16, stride)
            let before = up.3
            let here = middle.3
            let after = south.3
            let top = tzLifeUp(before.0, here.0)
            let bottom = tzLifeDown(here.0, after.0)
            let topCarry = tzLifeUp(before.1, here.1)
            let bottomCarry = tzLifeDown(here.1, after.1)
            let low = tzLifeSum(top, middle.1, bottom)
            let highBits = tzLifeSum(topCarry, middle.2, bottomCarry)
            // El n�mero de parejas debe ser impar y las triadas deben aportar menos de dos.
            let onePair = ~highBits.1 & (highBits.0 ^ low.1)
            let live = onePair & (low.0 | middle.0)
            simdStore(ptrAdd(output, at), live)
            any = any | live
            if counting {
                total = total + tzLifePopulation(live)
            }
            up = middle
            middle = south
        }
        if lo > 1 && ptrRead(ptrAdd(ptrConst(output), offset + lo * 16)) != u32(0) {
            first = lo - 1
        }
        if hi + 2 < stride / 16 && ptrRead(ptrAdd(ptrConst(output), offset + hi * 16 + 15)) != u32(0) {
            last = hi + 1
        }
        // Una celda del borde puede producir una en el bloque contiguo.
        if block == loBlock && block > 1 && tzLifeNonempty(any & one) {
            firstBlock = block - 1
        }
        if block == hiBlock && block < columns && tzLifeNonempty(any & high) {
            lastBlock = block + 1
        }
    }
    return (int(simdSum(total)), first, last, (firstBlock, lastBlock))
}

fn tzLifeReport(g: int, count: int) {
    pyOutI(g, false)
    write(" ")
    pyOutI(count, false)
    write("\n")
}

raw fn tzLifeSeed64(board: MutPtr<u32>, origin: int, stride: int, initial: int, multiplier: int, increment: int) -> int {
    var scales = repeat(u32(0), 64)
    var offsets = repeat(u32(0), 64)
    var multiplierPower = u32(1)
    var offset = u32(0)
    let mul = u32(multiplier)
    let add = u32(increment)
    for i in 0..64 {
        multiplierPower = wrappingMul(multiplierPower, mul)
        offset = wrappingAdd(wrappingMul(offset, mul), add)
        scales[i] = multiplierPower
        offsets[i] = offset
    }
    let vectorMagic = simdSplat<Simd<u32, 8>>(u32(10923))
    let high = simdSplat<Simd<u32, 8>>(u32(16))
    let truncation = simdSplat<Simd<u32, 8>>(u32(32767))
    let divide = simdSplat<Simd<u32, 8>>(u32(15))
    let three = simdSplat<Simd<u32, 8>>(u32(3))
    let zero = simdSplat<Simd<u32, 8>>(u32(0))
    let weights = simdFromArray<Simd<u32, 8>>([u32(1), u32(2), u32(4), u32(8), u32(16), u32(32), u32(64), u32(128)], 0)
    var seed = u32(initial)
    var population = 0
    let first = 1 + origin / 32
    let shift = u32(origin & 31)
    for row in origin..(origin + 64) {
        let start = simdSplat<Simd<u32, 8>>(seed)
        var living = u64(0)
        for part in 0..8 {
            let base = part * 8
            let turns = start * simdFromArray<Simd<u32, 8>>(scales, base) + simdFromArray<Simd<u32, 8>>(offsets, base)
            let sample = (turns >> high) & truncation
            let rest = sample - (((sample * vectorMagic) >> divide) * three)
            let bits = simdSum(simdCmpEq(rest, zero) & weights)
            living = living | (u64(bits) << u64(base))
            if part == 7 {
                seed = simdGet(turns, 7)
            }
        }
        let at = first * stride + row + 16
        for part in 0..2 {
            let cell = at + part * stride
            let word = u32((living >> u64(part * 32)) & u64(4294967295))
            let target = ptrAdd(board, cell)
            ptrWrite(target, ptrRead(ptrConst(target)) | (word << shift))
            if shift != u32(0) {
                let next = ptrAdd(target, stride)
                ptrWrite(next, ptrRead(ptrConst(next)) | (word >> (u32(32) - shift)))
            }
        }
        population = population + int(popcnt(living))
    }
    return population
}

trusted fn tzLife(generations: int, size: int, interval: int, initial: int, mul: int, add: int) {
    // Un vector de filas y una columna de palabras rodean ambos tableros.
    let origin = max(0, generations) + 1
    let side = size + 2 * origin
    let stride = ((side + 15) / 16 + 2) * 16
    let columns = (side + 31) / 32
    var first = (origin + 15) / 16
    var last = (origin + size + 16) / 16
    var firstBlock = 1 + (origin - 1) / 32
    var lastBlock = min(columns, 1 + (origin + size) / 32)
    // Los intervalos solo crecen y ambas tablas permanecen vac�as fuera de ellos.
    let words = (columns + 2) * stride
    var storage = repeat(u32(0), 2 * words)
    let a = mutSlicePtr(mut storage)
    let b = ptrAdd(a, words)
    var count = 0
    if size == 64 {
        raw { count = tzLifeSeed64(a, origin, stride, initial, mul, add) }
    } else {
        var seed = u32(initial)
        for row in origin..(origin + size) {
            for column in origin..(origin + size) {
                seed = wrappingAdd(wrappingMul(seed, u32(mul)), u32(add))
                if ((seed >> u32(16)) & u32(32767)) % u32(3) == u32(0) {
                    let at = (1 + column / 32) * stride + row + 16
                    raw {
                        let cell = ptrAdd(a, at)
                        ptrWrite(cell, ptrRead(ptrConst(cell)) | (u32(1) << u32(column & 31)))
                    }
                    count = count + 1
                }
            }
        }
    }
    for g in 0..generations {
        if g % interval == 0 {
            tzLifeReport(g, count)
        }
        let counting = (g + 1) % interval == 0 || g + 1 == generations
        var next = (0, 0, 0, (0, 0))
        raw {
            next = if (g & 1) == 0 {
                tzLifeStep(ptrConst(a), b, stride, columns, first, last, firstBlock, lastBlock, counting)
            } else {
                tzLifeStep(ptrConst(b), a, stride, columns, first, last, firstBlock, lastBlock, counting)
            }
        }
        count = next.0
        first = next.1
        last = next.2
        let blocks = next.3
        firstBlock = blocks.0
        lastBlock = blocks.1
    }
    tzLifeReport(generations, count)
}
