extern "C" {
    fn tzx_text_file_chunk(handle: int) -> int
    fn tzx_text_prepare(address: int, length: int, lower: int, flags: int) -> int
}

fn tzTextPunctuation(c: u8) -> bool {
    return c == u8(46) || c == u8(44) || c == u8(59) || c == u8(58) || c == u8(33) || c == u8(63)
}

raw fn tzTextToken(base: Ptr<u8>, start: int, end: int,
                      keys: mut [u64], scores: mut [int], extra: mut Map<str, int>) -> int {
    var lo = start
    var hi = end
    while lo < hi && tzTextPunctuation(ptrRead(ptrAdd(base, lo))) {
        lo = lo + 1
    }
    while lo < hi && tzTextPunctuation(ptrRead(ptrAdd(base, hi - 1))) {
        hi = hi - 1
    }
    let length = hi - lo
    if length == 0 {
        return 0
    }
    if length <= 8 {
        // El lector reserva ocho bytes para que esta carga sea válida al final.
        let bytes = ptrRead(ptrCast<u64>(ptrAdd(base, lo)))
        let keep = ~u64(0) >> u64(8 * (8 - length))
        let code = bytes & keep
        var slot = int(wrappingMul(code, u64(0x9e3779b185ebca87)) >> u64(56))
        for probe in 0..256 {
            let found = keys[slot]
            if found == code {
                scores[slot] = wrappingAdd(scores[slot], 1)
                return 1
            }
            if found == u64(0) {
                keys[slot] = code
                scores[slot] = 1
                return 1
            }
            slot = (slot + 1) & 255
        }
    }
    let word = strFromPtr(ptrAdd(base, lo), length)
    let count = if extra.has(word) { extra[word] } else { 0 }
    extra[word] = wrappingAdd(count, 1)
    return 1
}

raw fn tzTextPacked(base: Ptr<u8>, start: int, end: int) -> u64 {
    let length = end - start
    if length < 1 || length > 8 {
        return u64(0)
    }
    // El bloque en minúsculas tiene ocho bytes de margen y contiene ASCII sin NUL.
    let bytes = ptrRead(ptrCast<u64>(ptrAdd(base, start)))
    let last = ((bytes >> u64(8 * (length - 1))) & u64(255))
    if (bytes & u64(255)) < u64(64) {
        return u64(0)
    }
    var size = length
    if last < u64(64) {
        if length == 1 || !tzTextPunctuation(u8(last)) ||
           ((bytes >> u64(8 * (length - 2))) & u64(255)) < u64(64) {
            return u64(0)
        }
        size = size - 1
    }
    return bytes & (~u64(0) >> u64(8 * (8 - size)))
}

raw fn tzTextPair(base: Ptr<u8>, start: int, middle: int, end: int, keys: Ptr<u64>, scores: MutPtr<int>) -> bool {
    let first = tzTextPacked(base, start, middle)
    let second = tzTextPacked(base, middle + 1, end)
    if first == u64(0) || second == u64(0) {
        return false
    }
    let a = int(wrappingMul(first, u64(0x9e3779b185ebca87)) >> u64(56))
    let b = int(wrappingMul(second, u64(0x9e3779b185ebca87)) >> u64(56))
    if ptrRead(ptrAdd(keys, a)) != first || ptrRead(ptrAdd(keys, b)) != second {
        return false
    }
    ptrWrite(ptrAdd(scores, a), wrappingAdd(ptrRead(ptrAdd(scores, a)), 1))
    ptrWrite(ptrAdd(scores, b), wrappingAdd(ptrRead(ptrAdd(scores, b)), 1))
    return true
}

trusted fn tzTextLongest(base: Ptr<u8>, at: int, length: int, limit: int, longest: mut int, prefix: mut str) {
    if length > longest {
        longest = length
        prefix = strFromPtr(ptrAdd(base, at), min(limit, length))
    }
}

fn tzTextRank(word: str, score: int, ranked: mut [str], counts: mut [int], limit: int) {
    var place = limit - 1
    if score > counts[place] || (score == counts[place] && word < ranked[place]) {
        while place > 0 && (score > counts[place - 1] || (score == counts[place - 1] && word < ranked[place - 1])) {
            counts[place] = counts[place - 1]
            ranked[place] = ranked[place - 1]
            place = place - 1
        }
        counts[place] = score
        ranked[place] = word
    }
}

fn tzTextPrintTop(keys: [u64], scores: [int], extra: Map<str, int>, limit: int, width: int) {
    var ranked = repeat("", limit)
    var counts = repeat(0, limit)
    for slot in 0..256 {
        if scores[slot] == 0 {
            continue
        }
        var key = keys[slot]
        var word = ""
        while key != u64(0) {
            word = word + strFromByte(int(key & u64(255)))
            key = key >> u64(8)
        }
        tzTextRank(word, scores[slot], mut ranked, mut counts, limit)
    }
    for word in extra.keys() {
        tzTextRank(word, extra[word], mut ranked, mut counts, limit)
    }
    for rank in 0..limit {
        if counts[rank] == 0 {
            break
        }
        let word = ranked[rank]
        for pad in word.len()..width {
            write(" ")
        }
        write(word)
        write(" ")
        pyOutI(counts[rank], false)
        write("\n")
    }
}

trusted fn tzTextReport(path: str, prefixSize: int, limit: int, width: int) {
    var keys = repeat(u64(0), 256)
    var scores = repeat(0, 256)
    let keyView = slicePtr(keys)
    let scoreView = mutSlicePtr(mut scores)
    var folded = repeat(u8(0), 65544)
    var separators = repeat(u64(0), 1024)
    let lower = mutSlicePtr(mut folded)
    let marks = mutSlicePtr(mut separators)
    let lowerAddress = bitcast<int>(ptrAddr(lower))
    let marksAddress = bitcast<int>(ptrAddr(marks))
    var extra: Map<str, int> = mapNew()
    var lines = 0
    var words = 0
    var size = 0
    var longest = 0
    var prefix = ""
    let file = pyOpenAsciiFile(path)
    while true {
        let address = tzx_text_file_chunk(file)
        assert address != 0
        let length = tzx_file_len(file)
        if length == 0 {
            break
        }
        let original = ptrFromAddr<u8>(u64(address))
        let base = ptrConst(lower)
        size = size + length
        let rows = tzx_text_prepare(address, length, lowerAddress, marksAddress)
        assert rows >= 0
        lines = lines + (rows & 131071)
        tzTextLongest(original, rows >> 34, (rows >> 17) & 131071, prefixSize, mut longest, mut prefix)
        var token = 0
        let blocks = (length + 63) / 64
        for block in 0..blocks {
            let from = block * 64
            var flags = ptrRead(ptrAdd(marks, block))
            while flags != u64(0) {
                let i = from + int(ctz(flags))
                let rest = flags & wrappingSub(flags, u64(1))
                if rest != u64(0) {
                    let end = from + int(ctz(rest))
                    var paired = false
                    raw { paired = tzTextPair(base, token, i, end, keyView, scoreView) }
                    if paired {
                        words = wrappingAdd(words, 2)
                        token = end + 1
                        flags = rest & wrappingSub(rest, u64(1))
                        continue
                    }
                }
                if i > token {
                    var count = 0
                    raw { count = tzTextToken(base, token, i, mut keys, mut scores, mut extra) }
                    words = wrappingAdd(words, count)
                }
                token = i + 1
                flags = flags & wrappingSub(flags, u64(1))
            }
        }
        if token < length {
            var count = 0
            raw { count = tzTextToken(base, token, length, mut keys, mut scores, mut extra) }
            words = wrappingAdd(words, count)
        }
    }
    pyCloseAsciiFile(file)
    pyOutI(lines, false)
    write(" ")
    pyOutI(words, false)
    write(" ")
    pyOutI(size, false)
    write("\n")
    pyOutI(longest, false)
    write(" ")
    write(prefix)
    write("\n")
    tzTextPrintTop(keys, scores, extra, limit, width)
}
