extern "C" {
    fn tzx_text_file_chunk(handle: int) -> int
    fn tzx_text_prepare(handle: int, lower: int, flags: int, suffixes: int, longest: int) -> int
}

fn tzTextPunctuation(c: u8) -> bool {
    return c == u8(46) || c == u8(44) || c == u8(59) || c == u8(58) || c == u8(33) || c == u8(63)
}

trusted fn tzTextRehash(keys: mut [u64], scores: mut [int], initial: u64) -> u64 {
    var trial = repeat(u64(0), 256)
    var counts = repeat(0, 256)
    var candidate = initial
    for attempt in 0..32 {
        raw { ptrZero(mutSlicePtr(mut trial), 256) }
        var collision = false
        for slot in 0..256 {
            let key = keys[slot]
            if key != u64(0) {
                let index = int(wrappingMul(key, candidate) >> u64(56))
                if trial[index] != u64(0) {
                    collision = true
                    break
                }
                trial[index] = key
                counts[index] = scores[slot]
            }
        }
        if !collision {
            for slot in 0..256 {
                keys[slot] = trial[slot]
                scores[slot] = if trial[slot] != u64(0) { counts[slot] } else { 0 }
            }
            return candidate
        }
        candidate = wrappingAdd(candidate, u64(0xd1b54a32d192ed02))
    }
    return initial
}

raw fn tzTextToken(base: Ptr<u8>, start: int, end: int,
                      keys: mut [u64], scores: mut [int], extra: mut Map<str, int>, multiplier: u64) -> int {
    var lo = start
    var hi = end
    while lo < hi && tzTextPunctuation(ptrRead(ptrAdd(base, lo))) {
        lo = lo + 1
    }
    while lo < hi && tzTextPunctuation(ptrRead(ptrAdd(base, hi - 1))) {
        hi = hi - 1
    }
    let length = hi - lo
    if length == 0 {
        return 0
    }
    if length <= 8 {
        // El lector reserva ocho bytes para que esta carga sea válida al final.
        let bytes = ptrRead(ptrCast<u64>(ptrAdd(base, lo)))
        let keep = ~u64(0) >> u64(8 * (8 - length))
        let code = bytes & keep
        var slot = int(wrappingMul(code, multiplier) >> u64(56))
        for probe in 0..256 {
            let found = keys[slot]
            if found == code {
                scores[slot] = wrappingAdd(scores[slot], 1)
                return 1
            }
            if found == u64(0) {
                keys[slot] = code
                scores[slot] = 1
                return 1
            }
            slot = (slot + 1) & 255
        }
    }
    let word = strFromPtr(ptrAdd(base, lo), length)
    let count = if extra.has(word) { extra[word] } else { 0 }
    extra[word] = wrappingAdd(count, 1)
    return 1
}

raw fn tzTextPacked(base: Ptr<u8>, start: int, end: int) -> u64 {
    let length = end - start
    if length < 1 || length > 8 {
        return u64(0)
    }
    // El bloque en minúsculas tiene ocho bytes de margen y contiene ASCII sin NUL.
    let bytes = ptrRead(ptrCast<u64>(ptrAdd(base, start)))
    return bytes & (~u64(0) >> u64(8 * (8 - length)))
}

raw fn tzTextSlot(keys: Ptr<u64>, key: u64, multiplier: u64) -> int {
    let first = int(wrappingMul(key, multiplier) >> u64(56))
    if ptrRead(ptrAdd(keys, first)) == key {
        return first
    }
    let second = (first + 1) & 255
    return if ptrRead(ptrAdd(keys, second)) == key { second } else { -1 }
}

raw fn tzTextPair(base: Ptr<u8>, start: int, middle: int, end: int, signs: u64,
                  keys: Ptr<u64>, scores: MutPtr<int>, multiplier: u64) -> bool {
    let trimFirst = int((signs >> u64(middle & 63)) & u64(1))
    let trimSecond = int((signs >> u64(end & 63)) & u64(1))
    let first = tzTextPacked(base, start, middle - trimFirst)
    let second = tzTextPacked(base, middle + 1, end - trimSecond)
    if first == u64(0) || second == u64(0) {
        return false
    }
    // Las claves guardadas ya tienen recortados los signos de ambos extremos.
    let a = tzTextSlot(keys, first, multiplier)
    let b = tzTextSlot(keys, second, multiplier)
    if a < 0 || b < 0 {
        return false
    }
    ptrWrite(ptrAdd(scores, a), wrappingAdd(ptrRead(ptrAdd(scores, a)), 1))
    ptrWrite(ptrAdd(scores, b), wrappingAdd(ptrRead(ptrAdd(scores, b)), 1))
    return true
}

trusted fn tzTextLongest(base: Ptr<u8>, at: int, length: int, limit: int, longest: mut int, prefix: mut str) {
    if length > longest {
        longest = length
        prefix = strFromPtr(ptrAdd(base, at), min(limit, length))
    }
}

fn tzTextRank(word: str, score: int, ranked: mut [str], counts: mut [int], limit: int) {
    var place = limit - 1
    if score > counts[place] || (score == counts[place] && word < ranked[place]) {
        while place > 0 && (score > counts[place - 1] || (score == counts[place - 1] && word < ranked[place - 1])) {
            counts[place] = counts[place - 1]
            ranked[place] = ranked[place - 1]
            place = place - 1
        }
        counts[place] = score
        ranked[place] = word
    }
}

fn tzTextPrintTop(keys: [u64], scores: [int], extra: Map<str, int>, limit: int, width: int) {
    var ranked = repeat("", limit)
    var counts = repeat(0, limit)
    for slot in 0..256 {
        if scores[slot] == 0 {
            continue
        }
        var key = keys[slot]
        var word = ""
        while key != u64(0) {
            word = word + strFromByte(int(key & u64(255)))
            key = key >> u64(8)
        }
        tzTextRank(word, scores[slot], mut ranked, mut counts, limit)
    }
    for word in extra.keys() {
        tzTextRank(word, extra[word], mut ranked, mut counts, limit)
    }
    for rank in 0..limit {
        if counts[rank] == 0 {
            break
        }
        let word = ranked[rank]
        for pad in word.len()..width {
            write(" ")
        }
        write(word)
        write(" ")
        pyOutI(counts[rank], false)
        write("\n")
    }
}

trusted fn tzTextReport(path: str, prefixSize: int, limit: int, width: int) {
    var multiplier = u64(0x9e3779b185ebca87)
    var keys = repeat(u64(0), 256)
    var scores = repeat(0, 256)
    let keyView = slicePtr(keys)
    let scoreView = mutSlicePtr(mut scores)
    var folded = repeat(u8(0), 65544)
    var separators = repeat(u64(0), 1024)
    var suffixes = repeat(u64(0), 1024)
    let trims = mutSlicePtr(mut suffixes)
    let trimAddress = bitcast<int>(ptrAddr(trims))
    let lower = mutSlicePtr(mut folded)
    let marks = mutSlicePtr(mut separators)
    let lowerAddress = bitcast<int>(ptrAddr(lower))
    let marksAddress = bitcast<int>(ptrAddr(marks))
    var extra: Map<str, int> = mapNew()
    var lines = 0
    var words = 0
    var size = 0
    var longest = 0
    var prefix = ""
    let file = pyOpenAsciiFile(path)
    while true {
        let address = tzx_text_file_chunk(file)
        assert address != 0
        let rows = tzx_text_prepare(file, lowerAddress, marksAddress, trimAddress, longest)
        assert rows >= 0
        let length = tzx_file_len(file)
        if length == 0 {
            break
        }
        let original = ptrFromAddr<u8>(u64(address))
        let base = ptrConst(lower)
        size = size + length
        lines = lines + (rows & 131071)
        tzTextLongest(original, rows >> 34, (rows >> 17) & 131071, prefixSize, mut longest, mut prefix)
        var token = 0
        let blocks = (length + 63) / 64
        for block in 0..blocks {
            let from = block * 64
            let signs = ptrRead(ptrAdd(trims, block))
            var flags = ptrRead(ptrAdd(marks, block))
            while flags != u64(0) {
                let i = from + int(ctz(flags))
                let rest = flags & wrappingSub(flags, u64(1))
                if rest != u64(0) {
                    let end = from + int(ctz(rest))
                    var paired = false
                    raw { paired = tzTextPair(base, token, i, end, signs, keyView, scoreView, multiplier) }
                    if paired {
                        words = wrappingAdd(words, 2)
                        token = end + 1
                        flags = rest & wrappingSub(rest, u64(1))
                        continue
                    }
                }
                if i > token {
                    var count = 0
                    raw { count = tzTextToken(base, token, i, mut keys, mut scores, mut extra, multiplier) }
                    words = wrappingAdd(words, count)
                }
                token = i + 1
                flags = flags & wrappingSub(flags, u64(1))
            }
        }
        if token < length {
            var count = 0
            raw { count = tzTextToken(base, token, length, mut keys, mut scores, mut extra, multiplier) }
            words = wrappingAdd(words, count)
        }
        // Las claves del primer bloque orientan la tabla. Las posteriores conservan el sondeo lineal.
        if size == length {
            multiplier = tzTextRehash(mut keys, mut scores, multiplier)
        }
    }
    pyCloseAsciiFile(file)
    pyOutI(lines, false)
    write(" ")
    pyOutI(words, false)
    write(" ")
    pyOutI(size, false)
    write("\n")
    pyOutI(longest, false)
    write(" ")
    write(prefix)
    write("\n")
    tzTextPrintTop(keys, scores, extra, limit, width)
}
