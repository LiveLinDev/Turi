fn CAT_NAME(n: int) -> CAT_TYPE {
    let syllables = CAT_SYLLABLES
    var counts = repeat(0, CAT_SIZE)
CAT_KERNEL
CAT_FINISH
}

fn CAT_DECODE(index: int, syllables: [str]) -> str {
    var code = index
    var width = 1
    var block = CAT_RADIX
    while code >= block {
        code = code - block
        block = block * CAT_RADIX
        width = width + 1
    }
    var word = ""
    for i in 0..width {
        word = syllables[code % CAT_RADIX] + word
        code = code / CAT_RADIX
    }
    return word
}

CAT_EXTRA
CAT_CONVERSIONS
