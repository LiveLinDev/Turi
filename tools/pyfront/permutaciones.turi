fn tzPackHigher(initial: u64, counts: u64, n: int) -> (u64, u64, bool) {
    var value = initial
    var digits = counts
    for k in 4..n {
        let shift = bitcast<u64>(wrappingMul(k, 4)) & u64(63)
        let low = (~u64(0)) >> (wrappingSub(u64(0), shift) & u64(63))
        value = (value & ~((low << u64(4)) | u64(15))) | ((value >> u64(4)) & low) | ((value & u64(15)) << shift)
        digits = wrappingSub(digits, u64(1) << shift)
        if ((digits >> shift) & u64(15)) != u64(0) {
            return (value, digits, true)
        }
        digits = digits | (bitcast<u64>(wrappingAdd(k, 1)) << shift)
    }
    return (value, digits, false)
}

fn tzPackHigherSix(initial: u64, reverse: u64, counts: u64, n: int) -> (u64, u64, u64, bool) {
    var value = initial
    var inverted = reverse
    var digits = counts
    for k in 4..n {
        let shift = u64(k * 6)
        let reverseShift = u64(58) - shift
        let first = value & u64(63)
        let low = (~u64(0)) >> (u64(64) - shift)
        let high = (~u64(0)) << (reverseShift + u64(6))
        value = (value & ~((low << u64(6)) | u64(63))) | ((value >> u64(6)) & low) | (first << shift)
        inverted = (inverted & ~(high | (u64(63) << reverseShift))) |
            ((inverted << u64(6)) & high) | (first << reverseShift)
        let digit = u64(k * 4)
        digits = wrappingSub(digits, u64(1) << digit)
        if ((digits >> digit) & u64(15)) != u64(0) {
            return (value, inverted, digits, true)
        }
        digits = digits | (u64(k + 1) << digit)
    }
    return (value, inverted, digits, false)
}

fn tzPairsFannkuch(n: int) -> (int, int) {
    if n <= 10 {
        return tzPairsFannkuchSix(n)
    }
    return tzPairsFannkuchFour(n)
}

TZ_PERMUTATION_TEMPLATE

fn tzLeadingFlipsTZ_SUFFIX(initial: u64, inverse: u64, TZ_LEADING_PARAMETER,
                  bShift: Simd<u64, 8>, cShift: Simd<u64, 8>, dShift: Simd<u64, 8>) -> Simd<u64, 8> {
    let zero = simdSplat<Simd<u64, 8>>(u64(0))
    let width = simdSplat<Simd<u64, 8>>(u64(TZ_WIDTH))
    let last = simdSplat<Simd<u64, 8>>(u64(TZ_MASK))
    let starts = simdSplat<Simd<u64, 8>>(initial)
TZ_LEADING
    let b = (starts >> bShift) & last
    let c = (starts >> cShift) & last
    let d = (starts >> dShift) & last
    let direct = (TZ_DIRECT_HEAD) |
        (b << width) | (c << simdSplat<Simd<u64, 8>>(u64(TZ_THIRD))) | (d << simdSplat<Simd<u64, 8>>(u64(TZ_FOURTH)))
    let reversed = (TZ_REVERSE_HEAD) |
        (b << simdSplat<Simd<u64, 8>>(u64(TZ_REV_SECOND))) | (c << simdSplat<Simd<u64, 8>>(u64(TZ_REV_THIRD))) |
        (d << simdSplat<Simd<u64, 8>>(u64(TZ_REV_FOURTH)))
    let initialShift = TZ_INITIAL_SHIFT
    var value = (direct & ~((~zero) >> initialShift)) | (reversed >> initialShift)
    var reverse = (reversed & ~((~zero) << initialShift)) | (direct << initialShift)
    var flips = TZ_FIRST_FLIPS
    var first = value & last
    var active = TZ_ACTIVE
    while simdReduceMax(active) != u64(0) {
        let shift = TZ_SHIFT
        let prefix = (~zero) >> shift
        // El prefijo directo y el sufijo inverso se intercambian sin barajar bytes.
        let next = (value & ~prefix) | (reverse >> shift)
        reverse = (reverse & ~((~zero) << shift)) | (value << shift)
        value = next
        flips = flips - active
        first = value & last
        active = TZ_ACTIVE
    }
    return TZ_FINAL_FLIPS
}

fn tzPairsFannkuchTZ_SUFFIX(n: int) -> (int, int) {
    var digits = u64(0x0FEDCBA987654321)
    var permutation = TZ_PERMUTATION_INITIAL
TZ_PERMUTATION_INVERSE
    var flips = simdSplat<Simd<u64, 8>>(u64(0))
    var records = flips
TZ_PERMUTATION_CONTROLS
    while true {
TZ_PERMUTATION_REVERSE
TZ_PERMUTATION_GROUPS
        let next = TZ_PERMUTATION_ROTATE
        if !next.TZ_PERMUTATION_READY {
            break
        }
        permutation = next.0
TZ_PERMUTATION_ADVANCE
    }
    // Los carriles activos alternan paridad. Los repetidos solo contribuyen al máximo.
    let ab = wrappingSub(simdGet(flips, 0), simdGet(flips, 1))
    let cd = wrappingSub(simdGet(flips, 2), simdGet(flips, 3))
    let ef = wrappingSub(simdGet(flips, 4), simdGet(flips, 5))
TZ_CHECKSUM
    return (bitcast<int>(sum), bitcast<int>(simdReduceMax(records)))
}
