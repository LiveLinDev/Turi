extern "C" {
    fn tzx_queens_has_bmi2() -> i32
    fn tzx_queens_grid(data: u64, selected: u64) -> u64
}

fn pyQueensAvailableFive(cols: u32, left: u32, right: u32) -> u64 {
    // El paso de 13 bits deja dos separadores para una fila de hasta once columnas.
    let vertical = wrappingMul(u64(cols), u64(0x10008004002001))
    let rising = wrappingMul(u64(left & u32(2047)), u64(0x100040010004001)) & u64(0x7f03fc1ff0ffc7ff)
    let falling = wrappingMul(u64(right), u64(0x1001001001001)) & u64(0x7f07f87fc7fe7ff)
    return vertical & ~(rising | falling)
}

fn pyQueensProjectedRows(grid: u64, column: u64) -> int {
    let selected = grid & (u64(0x108421) << column)
    return int((wrappingMul(selected, u64(0x111110)) >> (u64(20) + column)) & u64(31))
}

raw fn pyQueensPackedCount5(cols: u32, available: u64, words: Ptr<u64>) -> u64 {
    // La resta pone a cero el separador de una fila si no tiene casillas disponibles.
    let limits = u64(0x8004002001000800)
    if (wrappingSub(available | limits, u64(0x10008004002001)) & limits) != limits {
        return u64(0)
    }
    let grid = tzx_queens_grid(available, wrappingMul(u64(cols), u64(0x10008004002001)))
    let suffix = int(cols >> (ctz(cols) + u32(1)))
    let distances = ptrRead(ptrAdd(words, TZ_QUEENS_GAP_BASE + suffix / 4))
    let gap = int((distances >> u64(16 * (suffix & 3))) & u64(1023))
    let index0 = 128 + 2 * pyQueensProjectedRows(grid, u64(0))
    let index1 = 192 + 2 * pyQueensProjectedRows(grid, u64(1))
    let index2 = 256 + 2 * pyQueensProjectedRows(grid, u64(2))
    let index3 = 320 + 2 * pyQueensProjectedRows(grid, u64(3))
    let index4 = 384 + 2 * pyQueensProjectedRows(grid, u64(4))
    let low = ptrRead(ptrAdd(words, index0)) & ptrRead(ptrAdd(words, index1)) &
              ptrRead(ptrAdd(words, index2)) & ptrRead(ptrAdd(words, index3)) & ptrRead(ptrAdd(words, index4))
    let high = ptrRead(ptrAdd(words, index0 + 1)) & ptrRead(ptrAdd(words, index1 + 1)) &
               ptrRead(ptrAdd(words, index2 + 1)) & ptrRead(ptrAdd(words, index3 + 1)) &
               ptrRead(ptrAdd(words, index4 + 1))
    return u64(popcnt(low & ptrRead(ptrAdd(words, 448 + 2 * gap)))) +
           u64(popcnt(high & ptrRead(ptrAdd(words, 449 + 2 * gap))))
}

raw fn pyQueensPackedFive(cols: u32, left: u32, right: u32, words: Ptr<u64>) -> u64 {
    return pyQueensPackedCount5(cols, pyQueensAvailableFive(cols, left, right), words)
}

raw fn pyQueensPackedSix(cols: u32, left: u32, right: u32, words: Ptr<u64>) -> u64 {
    var pending = cols & ~(left | right)
    if pending == u32(0) {
        return u64(0)
    }
    let suffix = pyQueensAvailableFive(cols, left << u32(1), right >> u32(1))
    var total = u64(0)
    while pending != u32(0) {
        let rest = pending & wrappingSub(pending, u32(1))
        let queen = pending ^ rest
        let omit = ptrRead(ptrAdd(words, TZ_QUEENS_THREAT_BASE + int(ctz(queen))))
        let count = pyQueensPackedCount5(cols ^ queen, suffix & ~omit, words)
        total = wrappingAdd(total, count)
        pending = rest
    }
    return total
}

TZ_QUEENS_SHORT_LEVELS

fn pyQueensRows5(available: u64, column: u32) -> int {
    // El producto reúne cinco bits separados por doce posiciones.
    let mask = (available >> u64(column)) & u64(0x1001001001001)
    return int((wrappingMul(mask, u64(0x1002004008010)) >> u64(48)) & u64(31))
}

fn pyQueensClosed5(cols: u32, left: u32, right: u32, table: [u64]) -> u64 {
    let first = cols & ~(left | right)
    if first == u32(0) {
        return u64(0)
    }
    var available = u64(first)
    for row in 1..5 {
        let mask = cols & ~((left << u32(row)) | (right >> u32(row)))
        if mask == u32(0) {
            return u64(0)
        }
        available = available | (u64(mask) << u64(12 * row))
    }
    var columns = cols
    let a = u32(ctz(columns))
    var previous = a
    var gap = 0
    let firstIndex = 128 + 2 * pyQueensRows5(available, a)
    var low = table[firstIndex]
    var high = table[firstIndex + 1]
    columns = columns & wrappingSub(columns, u32(1))
    for col in 1..5 {
        let index = u32(ctz(columns))
        columns = columns & wrappingSub(columns, u32(1))
        gap = 5 * gap + int(min(index - previous, u32(5))) - 1
        previous = index
        let key = 128 + 2 * (32 * col + pyQueensRows5(available, index))
        low = low & table[key]
        high = high & table[key + 1]
    }
    return u64(popcnt(low & table[448 + 2 * gap])) + u64(popcnt(high & table[449 + 2 * gap]))
}

fn pyQueensClosed4(cols: u32, left: u32, right: u32, table: [u64]) -> u64 {
    let first = cols & ~(left | right)
    if first == u32(0) {
        return u64(0)
    }
    let second = cols & ~((left << u32(1)) | (right >> u32(1)))
    let third = cols & ~((left << u32(2)) | (right >> u32(2)))
    let last = cols & ~((left << u32(3)) | (right >> u32(3)))
    let availability = u64(first) | (u64(second) << u64(16)) | (u64(third) << u64(32)) | (u64(last) << u64(48))
    let secondRest = cols & wrappingSub(cols, u32(1))
    let thirdRest = secondRest & wrappingSub(secondRest, u32(1))
    let lastRest = thirdRest & wrappingSub(thirdRest, u32(1))
    let a = ctz(cols)
    let b = ctz(secondRest)
    let c = ctz(thirdRest)
    let d = ctz(lastRest)
    // El producto coloca los bits de las cuatro filas en las posiciones 48 a 51.
    let keep = u64(0x0001000100010001)
    let multiply = u64(0x0001000200040008)
    let x = int((wrappingMul((availability >> u64(a)) & keep, multiply) >> u64(48)) & u64(15))
    let y = int((wrappingMul((availability >> u64(b)) & keep, multiply) >> u64(48)) & u64(15))
    let z = int((wrappingMul((availability >> u64(c)) & keep, multiply) >> u64(48)) & u64(15))
    let w = int((wrappingMul((availability >> u64(d)) & keep, multiply) >> u64(48)) & u64(15))
    let gaps = ((min(b - a, u32(4)) - u32(1)) << u32(4)) |
               ((min(c - b, u32(4)) - u32(1)) << u32(2)) | (min(d - c, u32(4)) - u32(1))
    return u64(popcnt(table[x] & table[16 + y] & table[32 + z] & table[48 + w] & table[64 + int(gaps)]))
}

fn pyQueensSearch(cols: u32, left: u32, right: u32, remaining: int, table: [u64]) -> u64 {
    if remaining == 5 && cols < u32(4096) {
        return pyQueensClosed5(cols, left, right, table)
    }
    if remaining == 4 && cols < u32(65536) {
        return pyQueensClosed4(cols, left, right, table)
    }
    var available = cols & ~(left | right)
    if remaining == 3 {
        let middle = cols & ~((left << u32(1)) | (right >> u32(1)))
        let end = cols & ~((left << u32(2)) | (right >> u32(2)))
        var total = u64(0)
        while available != u32(0) {
            let rest = available & wrappingSub(available, u32(1))
            let queen = available ^ rest
            available = rest
            let two = cols ^ queen
            let high = two & wrappingSub(two, u32(1))
            let low = two ^ high
            if high != (low << u32(1)) {
                let a = middle & two & ~((queen << u32(1)) | (queen >> u32(1)))
                let b = end & two & ~((queen << u32(2)) | (queen >> u32(2)))
                let count = popcnt(a) * popcnt(b) - popcnt(a & b)
                total = wrappingAdd(total, u64(count))
            }
        }
        return total
    }
    var total = u64(0)
    while available != u32(0) {
        let rest = available & wrappingSub(available, u32(1))
        let queen = available ^ rest
        available = rest
        let below = pyQueensSearch(cols ^ queen, (left | queen) << u32(1),
                                  (right | queen) >> u32(1), wrappingSub(remaining, 1), table)
        // Cada solución es una permutación de a lo sumo 20 columnas.
        total = wrappingAdd(total, below)
    }
    return total
}

trusted fn pyQueensStart(cols: u32, left: u32, right: u32, remaining: int, table: [u64], packed: bool) -> u64 {
    if packed {
        let words = slicePtr(table)
        var result = u64(0)
        // La búsqueda de hasta once columnas llama aquí con cinco a diez filas pendientes.
        raw {
            if remaining == 5 {
                result = pyQueensPackedFive(cols, left, right, words)
            } else if remaining == 6 {
                result = pyQueensPackedSix(cols, left, right, words)
            } else if remaining == 7 {
                result = pyQueensShort7(cols, left, right, words)
            } else if remaining == 8 {
                result = pyQueensShort8(cols, left, right, words)
            } else if remaining == 9 {
                result = pyQueensShort9(cols, left, right, words)
            } else {
                result = pyQueensShort10(cols, left, right, words)
            }
        }
        return result
    }
    return pyQueensSearch(cols, left, right, remaining, table)
}

trusted fn pyQueens(n: int) -> int {
    if n < 4 {
        return if n == 0 || n == 1 { 1 } else { 0 }
    }
    let table = [
        TZ_QUEENS_TAIL_TABLE
    ]
    let cols = (u32(1) << u32(n)) - u32(1)
    let packed = n >= 6 && n <= 11 && tzx_queens_has_bmi2() != i32(0)
    let half = (u32(1) << u32(n / 2)) - u32(1)
    var choices = half
    var solutions = u64(0)
    while choices != u32(0) {
        let rest = choices & wrappingSub(choices, u32(1))
        let queen = choices ^ rest
        choices = rest
        solutions = solutions + pyQueensStart(cols ^ queen, queen << u32(1), queen >> u32(1), n - 1, table, packed)
    }
    if n % 2 != 0 {
        // Con la primera reina en el centro, el reflejo se aplica a la segunda fila.
        let center = u32(1) << u32(n / 2)
        let left = center << u32(1)
        let right = center >> u32(1)
        let restCols = cols ^ center
        choices = half & restCols & ~(left | right)
        while choices != u32(0) {
            let rest = choices & wrappingSub(choices, u32(1))
            let queen = choices ^ rest
            choices = rest
            solutions = solutions + pyQueensStart(restCols ^ queen, (left | queen) << u32(1),
                                                  (right | queen) >> u32(1), n - 2, table, packed)
        }
    }
    return int(solutions * u64(2))
}
