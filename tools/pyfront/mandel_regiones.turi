fn tzMandelFactor(bytes: int) -> int {
    var k = bytes
    var base = 31
    var result = 1
    while k > 0 {
        if (k & 1) != 0 {
            result = wrappingMul(result, base) % 1000000007
        }
        base = wrappingMul(base, base) % 1000000007
        k = k / 2
    }
    return result
}

fn tzMandelGap(begin: int, end: int, n: int, inverse: float, imaginary: float,
                  base: int, seed: int) -> (int, int) {
    var x = begin
    var count = base
    var checksum = seed
    while x + 32 <= end {
        let result = tzMandelPixels4(x, n, inverse, imaginary)
        count = wrappingAdd(count, result.0)
        checksum = wrappingAdd(wrappingMul(checksum, 923521), result.1) % 1000000007
        x = x + 32
    }
    while x < end {
        let result = tzMandelPixels1(x, n, inverse, imaginary)
        count = wrappingAdd(count, result.0)
        checksum = wrappingAdd(wrappingMul(checksum, 31), result.1) % 1000000007
        x = x + 8
    }
    return (count, checksum)
}

fn tzMandelRow(n: int, inverse: float, imaginary: float, zones: [u16]) -> (int, int) {
    let band = min(TZ_REGION_RESOLUTION - 1, int(abs(imaginary) * float(TZ_REGION_RESOLUTION)))
    let end = int(zones[band + 1])
    let stride = 1.0 / float(TZ_REGION_RESOLUTION)
    let unit = stride / inverse
    let aligned = n & ~7
    var x = 0
    var count = 0
    var checksum = 0
    for run in int(zones[band])..end {
        let at = TZ_REGION_RESOLUTION + 1 + 2 * run
        let startCell = int(zones[at])
        let last = int(zones[at + 1])
        let stopCell = last >> 1
        let left = float(startCell) * stride - 1.5
        let right = float(stopCell) * stride - 1.5
        var first = max(x, int(float(startCell) * unit) & ~7)
        if float(first) * inverse - 1.5 < left {
            first = first + 8
        }
        var stop = min(aligned, (int(float(stopCell) * unit) + 1) & ~7)
        while stop > first && float(stop - 1) * inverse - 1.5 > right {
            stop = stop - 8
        }
        if first >= stop || float(first) * inverse - 1.5 < left {
            continue
        }
        let gap = tzMandelGap(x, first, n, inverse, imaginary, count, checksum)
        count = gap.0
        checksum = gap.1
        let factor = tzMandelFactor((stop - first) / 8)
        var bytes = 0
        if (last & 1) != 0 {
            count = wrappingAdd(count, stop - first)
            bytes = wrappingMul(255, wrappingMul(factor + 1000000006, 233333335) % 1000000007)
        }
        checksum = wrappingAdd(wrappingMul(checksum, factor), bytes) % 1000000007
        x = stop
    }
    return tzMandelGap(x, n, n, inverse, imaginary, count, checksum)
}
