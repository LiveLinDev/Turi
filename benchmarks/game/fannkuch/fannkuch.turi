fn fannkuch(n: int) -> int {
    var perm = repeat(0, n)
    var perm1 = repeat(0, n + 1)
    var count = repeat(0, n + 1)
    for i in 0..n {
        perm1[i] = i
    }
    var maxFlips = 0
    var checksum = 0
    var permCount = 0
    var r = n
    while true {
        while r != 1 {
            count[r - 1] = r
            r -= 1
        }
        for i in 0..n {
            perm[i] = perm1[i]
        }
        var flips = 0
        var k = perm[0]
        while k != 0 {
            var i = 0
            var j = k
            while i < j {
                let t = perm[i]
                perm[i] = perm[j]
                perm[j] = t
                i += 1
                j -= 1
            }
            flips += 1
            k = perm[0]
        }
        if flips > maxFlips {
            maxFlips = flips
        }
        if permCount % 2 == 0 {
            checksum += flips
        } else {
            checksum -= flips
        }
        while true {
            if r == n {
                print(checksum)
                return maxFlips
            }
            let first = perm1[0]
            for i in 0..r {
                perm1[i] = perm1[i + 1]
            }
            perm1[r] = first
            count[r] -= 1
            if count[r] > 0 {
                break
            }
            r += 1
        }
        permCount += 1
    }
    return maxFlips
}

fn main() {
    let n = if argsCount() > 1 { parseInt(argAt(1)) } else { 7 }
    print(fannkuch(n))
}
