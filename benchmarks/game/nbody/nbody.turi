struct Body { x: float, y: float, z: float, vx: float, vy: float, vz: float, mass: float }

const kPi: float = 3.141592653589793
const kSolarMass: float = 39.47841760435743
const kDays: float = 365.24

fn energy(b: [Body]) -> float {
    var e = 0.0
    let n = b.len()
    for i in 0..n {
        e += 0.5 * b[i].mass * (b[i].vx * b[i].vx + b[i].vy * b[i].vy + b[i].vz * b[i].vz)
        for j in i + 1..n {
            let dx = b[i].x - b[j].x
            let dy = b[i].y - b[j].y
            let dz = b[i].z - b[j].z
            e -= b[i].mass * b[j].mass / (dx * dx + dy * dy + dz * dz).sqrt()
        }
    }
    return e
}

fn advance(b: mut [Body], dt: float, steps: int) {
    let n = b.len()
    for s in 0..steps {
        for i in 0..n {
            for j in i + 1..n {
                let dx = b[i].x - b[j].x
                let dy = b[i].y - b[j].y
                let dz = b[i].z - b[j].z
                let d2 = dx * dx + dy * dy + dz * dz
                let mag = dt / (d2 * d2.sqrt())
                b[i].vx -= dx * b[j].mass * mag
                b[i].vy -= dy * b[j].mass * mag
                b[i].vz -= dz * b[j].mass * mag
                b[j].vx += dx * b[i].mass * mag
                b[j].vy += dy * b[i].mass * mag
                b[j].vz += dz * b[i].mass * mag
            }
        }
        for i in 0..n {
            b[i].x += dt * b[i].vx
            b[i].y += dt * b[i].vy
            b[i].z += dt * b[i].vz
        }
    }
}

fn main() {
    let n = if argsCount() > 1 { parseInt(argAt(1)) } else { 1000 }
    var b = [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: kSolarMass },
        Body { x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01, vx: 1.66007664274403694e-03 * kDays, vy: 7.69901118419740425e-03 * kDays, vz: -6.90460016972063023e-05 * kDays, mass: 9.54791938424326609e-04 * kSolarMass },
        Body { x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01, vx: -2.76742510726862411e-03 * kDays, vy: 4.99852801234917238e-03 * kDays, vz: 2.30417297573763929e-05 * kDays, mass: 2.85885980666130812e-04 * kSolarMass },
        Body { x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01, vx: 2.96460137564761618e-03 * kDays, vy: 2.37847173959480950e-03 * kDays, vz: -2.96589568540237556e-05 * kDays, mass: 4.36624404335156298e-05 * kSolarMass },
        Body { x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01, vx: 2.68067772490389322e-03 * kDays, vy: 1.62824170038242295e-03 * kDays, vz: -9.51592254519715870e-05 * kDays, mass: 5.15138902046611451e-05 * kSolarMass },
    ]
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for i in 0..b.len() {
        px += b[i].vx * b[i].mass
        py += b[i].vy * b[i].mass
        pz += b[i].vz * b[i].mass
    }
    b[0].vx = -px / kSolarMass
    b[0].vy = -py / kSolarMass
    b[0].vz = -pz / kSolarMass
    print(energy(b))
    advance(mut b, 0.01, n)
    print(energy(b))
}
