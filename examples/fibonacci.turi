// Devuelve el término n de la sucesión de Fibonacci.
fn fib(n: int) -> int {
    var a = 0
    var b = 1
    for i in 0..n {
        let next = a + b
        a = b
        b = next
    }
    return a
}

fn main() {
    print(fib(10))
}

test "décimo término" {
    assert fib(0) == 0
    assert fib(10) == 55
}
